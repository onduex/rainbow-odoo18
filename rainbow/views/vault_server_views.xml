    <record id="vault_server_action" model="ir.actions.act_window">
        <field name="name">Vault servers</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">vault.server</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="vault_server_view_tree"/>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Vault Server connections.
            </p>
        </field>
    </record>

