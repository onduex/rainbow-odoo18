<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="vault_server_view_form" model="ir.ui.view">
        <field name="name">vault.server.view.form</field>
        <field name="model">vault.server</field>
        <field name="arch" type="xml">
            <form string="Vault Server">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="test_connection" type="object" string="Test connection" icon="fa-desktop"/>
                    </div>
                    <group>
                        <group name="server_data" string="SERVER DATA">
                            <field name="name"/>
                            <field name="app_code"/>
                        </group>
                        <group name="credentials" string="CREDENTIALS">
                            <field name="user_name"/>
                            <field name="user_password" password="True"/>
                            <field name="knowledge_vault"/>
                        </group>
                    </group>
                    <group>
                        <group name="get_data" string="GET DATA">
                            <field name="token" widget="vault_token_widget"/>
                            <field name="vault_id"/>
                            <field name="vault_user_id"/>
                        </group>
                        <group name="other_data" string="OTHER DATA">
                            <field name="company_id"
                                   options="{'no_create': True, 'no_create_edit': True,
                                   'no_quick_create': True, 'no_open': True}"/>
                        </group>
                    </group>
                    <!--<notebook>
                        <page name="vault_categories" string="Categories">
                            <group>
                                <field name="total_vault_categories"/>
                            </group>
                            <div>
                                <field name="vault_category_ids" nolabel="1">
                                    <tree create="0" limit="100" editable="top">
                                        <field name="vault_internal_id" readonly="1"/>
                                        <field name="name" readonly="1"/>
                                        <field name="description" readonly="1"/>
                                        <field name="vault_sys_name" readonly="1"/>
                                        <field name="product_categ_id"/>
                                        <field name="no_update_categ_id"/>
                                        <field name="route_ids" widget="many2many_tags"/>
                                        <field name="no_update_route_ids"/>
                                        <field name="type"/>
                                        <field name="no_update_type"/>
                                    </tree>
                                </field>
                            </div>
                        </page>
                        <page name="vault_uom" string="UoM">
                            <group>
                                <field name="total_vault_uom"/>
                            </group>
                            <div>
                                <field name="vault_uom_ids" nolabel="1">
                                    <tree create="0" limit="100" editable="top">
                                        <field name="vault_internal_id" readonly="1"/>
                                        <field name="name" readonly="1"/>
                                        <field name="abbreviation" readonly="1"/>
                                        <field name="vault_sys_name" readonly="1"/>
                                        <field name="conversion" readonly="1"/>
                                        <field name="uom_id"/>
                                    </tree>
                                </field>
                            </div>
                        </page>
                        <page name="vault_life_cycle" string="Life Cycles">
                            <div>
                                <field name="vault_life_cycle_ids" nolabel="1" mode="tree,kanban">
                                    <tree create="0" limit="100" editable="top">
                                        <field name="vault_internal_id" readonly="1"/>
                                        <field name="name" readonly="1"/>
                                        <field name="description" readonly="1"/>
                                        <field name="sys_name" readonly="1"/>
                                        <field name="total_states" readonly="1"/>
                                    </tree>
                                </field>
                            </div>
                        </page>
                        <page name="vault_properties" string="Product Properties">
                            <div class="o_row" title="Product Properties">
                                <button type="object"
                                        name="get_vault_product_properties"
                                        class="btn-success fa fa-arrow-down"
                                        string=" Import"
                                        help="Import new product products from vault server"/>
                            </div>
                            <br/>
                            <group>
                                <field name="vault_custom_revision"
                                       required="has_properties == True"
                                       options="{'no_create': True, 'no_create_edit': True, 'no_quick_create': True, 'no_open': True}"/>
                                <field name="company_id"
                                       options="{'no_create': True, 'no_create_edit': True, 'no_quick_create': True, 'no_open': True}"/>
                            </group>
                            <div>
                                <field name="vault_product_property_ids" nolabel="1">
                                    <tree create="0" limit="100" editable="top">
                                        <field name="vault_internal_id" readonly="1"/>
                                        <field name="vault_name" readonly="1"/>
                                        <field name="name" readonly="1"/>
                                        <field name="type" readonly="1"/>
                                        <field name="odoo_field_ids" column_invisible="1"/>
                                        <field name="product_field_id"
                                               domain="[('id', 'in', odoo_field_ids)]"
                                               options="{'no_create_edit': True, 'no_quick_create': True}"/>
                                    </tree>
                                </field>
                            </div>
                        </page>
                        <page name="vault_products" string="Products">
                            <div class="o_row" title="Products">
                                <button type="object"
                                        name="get_vault_products"
                                        class="btn-success fa fa-arrow-down"
                                        string=" Import"
                                        help="Import new products from vault server"/>
                                <button type="object"
                                        name="sync_vault_products"
                                        class="btn-info fa fa-refresh"
                                        string=" Synchronize"
                                        help="Synchronize the existing products from vault server"/>
                            </div>
                            <br/>
                            <group id="properties_alert">
                                <div class="alert alert-warning" role="alert"
                                     invisible="has_properties == True">
                                    <span class="fa fa-info-circle" title="Alert"/>
                                    <p>Maybe you should import and map the Vault properties before to import products.
                                    </p>
                                </div>
                            </group>
                            <group>
                                <field name="request_from"/>
                                <field name="hours_to_subtract"/>
                                <field name="total_vault_products"/>
                            </group>
                        </page>
                        <page name="product_fields" string="Product fields mapper">
                            <div id="properties_alert">
                                <div class="alert alert-info" role="alert">
                                    <p>
                                        <span class="fa fa-info-circle"/>
                                        Map product fields to set in a new revision with the values of the previous
                                        revision.
                                    </p>
                                </div>
                            </div>
                            <div>
                                <field name="product_field_ids" nolabel="1">
                                    <tree limit="100" editable="top">
                                        <field name="name" readonly="1"/>
                                        <field name="field_description" readonly="1"/>
                                        <field name="ttype" readonly="1"/>
                                    </tree>
                                </field>
                            </div>
                        </page>
                    </notebook>-->
                </sheet>
            </form>
        </field>
    </record>

    <record id="vault_server_view_tree" model="ir.ui.view">
        <field name="name">vault.server.view.tree</field>
        <field name="model">vault.server</field>
        <field name="arch" type="xml">
            <list string="Vault Servers">
                <field name="name"/>
                <field name="app_code"/>
                <field name="user_name"/>
                <field name="user_password" password="True"/>
                <field name="knowledge_vault"/>
            </list>
        </field>
    </record>

