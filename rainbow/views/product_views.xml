<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_view_form_inherit_rainbow" model="ir.ui.view">
        <field name="name">product.template.view.form.inherit.rainbow</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='type']" position="after">
                <field name="is_vault_product" invisible="0"/>
            </xpath>
            <xpath expr="//page[@name='inventory']" position="after">
                <page name="vault_info" string="Vault Info" invisible="is_vault_product != True">
                    <group name="vault_product">
                        <group>
                            <field name="vault_master_id" readonly="1"/>
                            <field name="vault_internal_id" readonly="1"/>
                            <field name="vault_revision" readonly="1"/>
                        </group>
                        <group>
                            <field name="vault_last_update" readonly="1"/>
                            <field name="vault_server_id" widget="selection"/>
                            <field name="vault_web_link" widget="url"/>
                            <field name="vault_desktop_link" widget="url"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="product_template_view_tree_inherit_rainbow" model="ir.ui.view">
        <field name="name">product.template.view.tree.inherit.rainbow</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="vault_revision"/>
            </field>
        </field>
    </record>

    <record id="product_template_view_kanban_inherit_rainbow" model="ir.ui.view">
       <field name="name">product.template.view.kanban.inherit.rainbow</field>
       <field name="model">product.template</field>
       <field name="inherit_id" ref="product.product_template_kanban_view"/>
       <field name="arch" type="xml">
           <xpath expr="//span[@t-if='record.default_code.value']" position="replace">
               <span t-if="record.default_code.value and record.vault_revision.value">
                   [<field name="default_code"/>-<field name="vault_revision"/>]
               </span>
               <t t-else="">[<field name="default_code"/>]</t>
           </xpath>
       </field>
   </record>

    <record id="product_template_view_search_inherit_rainbow" model="ir.ui.view">
        <field name="name">product.template.view.search.inherit.rainbow</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='filter_to_sell']" position="before">
                <filter string="Vault Products" name="vault_products" domain="[('is_vault_product', '=', True)]"/>
                <separator/>
            </xpath>
        </field>
    </record>

</odoo>
