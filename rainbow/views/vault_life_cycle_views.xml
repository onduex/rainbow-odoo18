<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="vault_life_cycle_view_form" model="ir.ui.view">
    <field name="name">vault.life.cycle.view.form</field>
    <field name="model">vault.life.cycle</field>
    <field name="arch" type="xml">
      <form string="Vault Life Cycle">
        <group>
          <group>
            <field name="name" readonly="1"/>
            <field name="description" readonly="1"/>
          </group>
          <group>
            <field name="vault_internal_id" readonly="1"/>
            <field name="sys_name" readonly="1"/>
          </group>
        </group>
        <group name="life_cycle_states" string="States">
          <field name="life_cycle_state_ids" nolabel="1">
            <form string="Vault Life Cycle State">
              <group>
                <group>
                  <field name="name"/>
                  <field name="description"/>
                </group>
                <group>
                  <field name="vault_internal_id"/>
                </group>
              </group>
              <group>
                <group>
                  <field name="is_release"/>
                  <field name="is_obsolete"/>
                  <field name="use_to_import"/>
                </group>
              </group>
            </form>
            <tree>
              <field name="vault_internal_id"/>
              <field name="name"/>
              <field name="description"/>
              <field name="is_release"/>
              <field name="is_obsolete"/>
              <field name="use_to_import"/>
            </tree>
          </field>
        </group>
      </form>
    </field>
  </record>

  <record id="vault_life_cycle_state_view_tree" model="ir.ui.view">
    <field name="name">vault.life.cycle.state.view.tree</field>
    <field name="model">vault.life.cycle.state</field>
    <field name="arch" type="xml">
      <tree string="Vault Life Cycle States" editable="top" create="0">
        <field name="vault_internal_id" readonly="1"/>
        <field name="name" readonly="1"/>
        <field name="description" readonly="1"/>
        <field name="is_release" readonly="1"/>
        <field name="is_obsolete" readonly="1"/>
        <field name="use_to_import"/>
      </tree>
    </field>
  </record>

  <record id="vault_life_cycle_state_view_search" model="ir.ui.view">
    <field name="name">vault.life.cycle.state.view.search</field>
    <field name="model">vault.life.cycle.state</field>
    <field name="arch" type="xml">
      <search string="Search Life Cycle States">
        <field name="name"/>
        <field name="vault_internal_id"/>
        <field name="life_cycle_id"/>
        <filter name="use_to_import" string="Use to import" domain="[('use_to_import', '=', True)]"/>
      </search>
    </field>
  </record>

  <record id="vault_life_cycle_state_action" model="ir.actions.act_window">
    <field name="name">Vault Life Cycle States</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">vault.life.cycle.state</field>
    <field name="view_mode">tree</field>
    <field name="context">{}</field>
    <field name="help" type="html">
      <p class="oe_view_nocontent_create">
        Vault Life Cycle States.
      </p>
    </field>
  </record>

  <menuitem id="vault_life_cycle_state_menu"
            name="Vault Life Cycle States"
            parent="vault_server_items_menu"
            action="vault_life_cycle_state_action"
            sequence="30"/>

</odoo>
