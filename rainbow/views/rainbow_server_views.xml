<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="rainbow_server_view_list" model="ir.ui.view">
        <field name="name">rainbow.server.view.list</field>
        <field name="model">rainbow.server</field>
        <field name="arch" type="xml">
            <list string="Rainbow Server">
                <field name="name"/>
                <field name="endpoint_password"/>
            </list>
        </field>
    </record>

    <record id="rainbow_server_action" model="ir.actions.act_window">
        <field name="name">Rainbow server</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">rainbow.server</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Rainbow Server allows you to manage your Rainbow server configurations
            </p>
        </field>
    </record>

    <menuitem id="rainbow_server_menu"
              name="Rainbow server"
              parent="vault_server_root_menu"
              action="rainbow_server_action"
              sequence="30"/>

</odoo>
