<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="vault_server_service_view_tree" model="ir.ui.view">
    <field name="name">vault.server.service.view.tree</field>
    <field name="model">vault.server.service</field>
    <field name="arch" type="xml">
      <tree string="Vault Services" editable="top" create="0">
        <field name="name"/>
        <field name="key"/>
        <field name="wsdl_service"/>
      </tree>
    </field>
  </record>

  <record id="vault_server_service_view_search" model="ir.ui.view">
    <field name="name">vault.server.service.search.view</field>
    <field name="model">vault.server.service</field>
    <field name="arch" type="xml">
      <search string="Search Categories">
        <field name="key"/>
      </search>
    </field>
  </record>

  <record id="vault_server_service_action" model="ir.actions.act_window">
    <field name="name">Vault Services</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">vault.server.service</field>
    <field name="view_mode">tree</field>
    <field name="help" type="html">
      <p class="oe_view_nocontent_create">
        Vault Services.
      </p>
    </field>
  </record>

  <menuitem id="vault_service_menu"
            name="Vault Services"
            parent="vault_server_root_menu"
            action="vault_server_service_action"
            sequence="30"/>

</odoo>
